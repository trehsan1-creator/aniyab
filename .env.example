# ═══════════════════════════════════════════════════════════════════════════
#  Aniyab Smart Assistant v2 — environment template
#  Copy to `.env.local` for local work; set the same keys in Vercel for prod.
#  Never commit real keys. Every secret below is optional except NVIDIA_API_KEY.
# ═══════════════════════════════════════════════════════════════════════════

# ── LLM (required for real answers; scripted mode works without it) ────────
# Which provider serves inference: nvidia (default) | laya
LLM_PROVIDER=nvidia
# NVIDIA NIM key — https://build.nvidia.com → "Get API Key"
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Preferred model; the app walks its own chain if this id 404s on your account.
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# ── Laya.Studio decision API (optional; the app degrades to NVIDIA-only) ───
# Laya is NOT a chat model. It answers calibrated questions about a turn:
# which tool should run, how hard the turn is, how urgent a report is.
# Endpoint: https://api.laya.studio/v1/systemone
LAYA_SYSTEMONE_ENDPOINT=https://api.laya.studio/v1/systemone
# live (default when a key exists) | off.  No other value has meaning any more.
LAYA_SYSTEMONE_MODE=live
# Persian needs the multilingual checkpoint — do not set this to `english`.
LAYA_MODEL=multilingual
LAYA_SYSTEMONE_TIMEOUT_MS=4000
# Bearer key: lsk_live_…
LAYA_API_KEY=
# Thresholds (probability above which we act without asking the model again)
LAYA_TOOL_THRESHOLD=0.7
LAYA_TIER_THRESHOLD=0.65
LAYA_URGENCY_THRESHOLD=0.6

# ── Supabase (optional; without it the app runs on an in-memory store) ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Security / identity ───────────────────────────────────────────────────
# Pepper for national-ID hashing. Set a long random string in production and
# never rotate it after data exists (lookups are hash-equality based).
PII_HASH_PEPPER=
# Demo OTP for phone binding. Shown in the UI when set to a demo value.
DEMO_OTP=12345
# /admin password. Leave empty to disable the dashboard entirely.
ADMIN_PASSWORD=

# ── Product / demo switches ───────────────────────────────────────────────
NEXT_PUBLIC_SHOP_URL=https://aniyab.com
# "1" shows the floating دمو badge; "0" hides it for a clean customer view.
NEXT_PUBLIC_DEMO_BADGE=1
# "1" enables ?demo=1 (persona switcher, reset, fast-forward). Production default: off.
NEXT_PUBLIC_DEMO_TOOLS=0
# "1" forces canned narration for every turn (stage safety net).
NEXT_PUBLIC_DEMO_SCRIPTED=0
# Server-side override of the same switch.
DEMO_SCRIPTED=0
# envelope = deterministic JSON action fallback path; unset = native tool calling.
AGENT_MODE=

# ── Local mock upstreams (see scripts/mock-laya.cjs) ──────────────────────
# Point these at :4100/:4200 to develop with zero API keys and zero network.
# NVIDIA_API_ENDPOINT=http://127.0.0.1:4100/v1/chat/completions
# LAYA_SYSTEMONE_ENDPOINT=http://127.0.0.1:4200/v1/systemone
# LAYA_API_KEY=mock-laya-key
