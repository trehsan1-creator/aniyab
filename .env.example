# ══════════════════════════════════════════════════════════════════════════════
#  ANIYAB — environment configuration
#
#  Two separate concerns:
#    INFERENCE      → NVIDIA NIM  (integrate.api.nvidia.com)
#    ORCHESTRATION  → Laya SystemOne (optional)
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Inference: NVIDIA NIM ────────────────────────────────────────────────
# Key from https://build.nvidia.com (join the NVIDIA Developer Program first).
# Server-side only — never prefix with NEXT_PUBLIC_.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── 2. Orchestration: Laya SystemOne (optional) ─────────────────────────────
# Leave the endpoint empty to run NVIDIA-only.
LAYA_SYSTEMONE_ENDPOINT=
LAYA_API_KEY=

# off (default) | preflight | orchestrate
#   off         → NVIDIA only, SystemOne never called
#   preflight   → SystemOne returns hints (prompt/model/temp), we call NVIDIA
#   orchestrate → SystemOne owns the model call; NVIDIA is the automatic fallback
LAYA_SYSTEMONE_MODE=off
LAYA_SYSTEMONE_TIMEOUT_MS=6000

# ── 3. Optional: use Laya as the inference provider instead of NVIDIA ───────
LLM_PROVIDER=nvidia          # nvidia | laya
LAYA_API_ENDPOINT=           # only needed when LLM_PROVIDER=laya
LAYA_MODEL=meta/llama-3.1-8b-instruct

# ── 4. Runtime tuning ───────────────────────────────────────────────────────
# Must stay BELOW maxDuration in vercel.json (60), otherwise the platform kills
# the stream before our own timeout can return a clean Persian error.
LLM_TIMEOUT_MS=45000
