# ── Laya.Studio Orchestrator ───────────────────────────────────────────────
# Full URL of the gateway endpoint. Either the OpenAI-compatible completions
# route or the SystemOne gateway is fine — the handler negotiates Content-Type.
LAYA_API_ENDPOINT=https://api.laya.studio/v1/chat/completions

# Server-side only. NEVER prefix with NEXT_PUBLIC_ — this must never reach the browser.
LAYA_API_KEY=

# Upstream model served through NVIDIA NIM.
LAYA_MODEL=meta/llama-3.1-8b-instruct

# Hard ceiling for a single upstream call (ms). Keep below your platform's limit.
LAYA_TIMEOUT_MS=45000
